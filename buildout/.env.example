# ============================================================================
# buildout/.env.example
# ============================================================================
# Copy to `.env` and fill in the placeholder values. Source with `source .env`
# before running scripts/deploy.sh.
#
#   cp .env.example .env
#   $EDITOR .env
#   source .env
#
# `.env` is gitignored; this template is not.
# ============================================================================

# --- Required for every deployment ------------------------------------------

# Azure subscription to deploy into.
export SUBSCRIPTION_ID="<subscription_id>"

# Primary Azure region (must match what's in parameters/*.bicepparam).
export LOCATION="westeurope"

# Strong password used by the PostgreSQL administrator account. The app
# itself uses Entra ID, but this password is required to provision the
# server and to recover access if AAD auth ever fails.
#   Generate one with:
#     openssl rand -base64 24 | tr -d '+/=' | head -c 24
export PG_ADMIN_PASSWORD="<replace-me>"

# --- Required only when deploying the optional Ollama VM --------------------

# Public SSH key authorized on the Ollama VM.
export SSH_PUBLIC_KEY="$(cat ~/.ssh/id_ed25519.pub 2>/dev/null || echo '')"

# Your current public IP — used in the Ollama NSG SSH allow-rule.
export ADMIN_IP="$(curl -fsSL https://api.ipify.org 2>/dev/null || echo '')"
