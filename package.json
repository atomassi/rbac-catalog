{
  "name": "azurerbac-frontend",
  "version": "1.0.0",
  "description": "Frontend build for Azure RBAC Monitor",
  "scripts": {
    "build:css": "tailwindcss -i ./azurerbac/web/static/css/input.css -o ./azurerbac/web/static/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./azurerbac/web/static/css/input.css -o ./azurerbac/web/static/css/tailwind.min.css --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "playwright": "^1.57.0"
  }
}
