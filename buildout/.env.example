# ============================================================================
# buildout/.env.example
# ============================================================================
# Copy to `.env`, edit, source, then run scripts/deploy.sh:
#
#   cp .env.example .env
#   $EDITOR .env
#   source .env
#   ./scripts/deploy.sh prod
#
# `.env` is gitignored; this template is not.
# ============================================================================

# --- Required for every deployment ------------------------------------------

# Azure subscription to deploy into.
export SUBSCRIPTION_ID="<subscription_id>"

# Resource group to create or update (no leading slash).
export RG_NAME="myapp-rg"

# Name prefix for every resource the buildout creates. 3-15 alphanumeric
# chars; the ACR, App Service, and PG server names derived from this MUST
# be globally unique, so pick something distinctive.
export BASE_NAME="myapp"

# Primary Azure region. PG Flexible Server availability varies by SKU and
# subscription; if the deploy errors with ``LocationIsOfferRestricted``,
# try ``northeurope``, ``swedencentral``, ``francecentral``, ``uksouth``.
export LOCATION="westeurope"

# Strong password used to bootstrap the PostgreSQL administrator account.
# The app itself uses Entra ID (MSI) for DB auth — this password is only
# needed during initial deployment so the AAD-mapped roles can be created.
#   Generate with:
#     openssl rand -base64 24 | tr -d '+/=' | head -c 24
export PG_ADMIN_PASSWORD="<replace-me>"
